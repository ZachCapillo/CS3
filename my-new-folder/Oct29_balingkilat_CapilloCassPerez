class healthpotion:
    def use(self):
        print("You regain 50 HP!")


class manapotion:
    def use(self):
        print("You restore 30 MP!")


class speedboost:
    def use(self):
        print("Your speed increases for 10 seconds!")


def apply_item(item):
    item.use()


potions = [
    HealthPotion(),
    ManaPotion(),
    SpeedBoost()
]



for potion in potions:
    apply_item(potion)
